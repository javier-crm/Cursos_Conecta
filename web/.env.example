# Copia este archivo a .env.local y llena los valores.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. NUNCA con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (semanas 4–5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Facturama (facturación CFDI, semanas 4–5) ---
# Sandbox: crea tu cuenta de pruebas en apisandbox.facturama.mx
FACTURAMA_USER=
FACTURAMA_PASSWORD=
FACTURAMA_SANDBOX=true
# Datos del emisor (deben coincidir con tu CSD cargado en Facturama)
FACTURAMA_EXPEDITION_PLACE=64000        # C.P. de tu domicilio fiscal
FACTURAMA_PRODUCT_CODE=86101610         # Clave SAT servicios de capacitación (confírmala con tu contador)

# --- Zoom (semanas 5–6): app Server-to-Server OAuth en marketplace.zoom.us ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Correos por SMTP (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@tudominio.com
SMTP_PASSWORD=
EMAIL_FROM="Cursos en Vivo <hola@tudominio.com>"
# Alternativa si no usas SMTP: Resend
RESEND_API_KEY=

# --- Cron de recordatorios (Vercel lo manda automáticamente; genera un secreto aleatorio) ---
CRON_SECRET=

# --- Video (opcional, mejora futura): Bunny Stream o Mux en lugar de la liga de Zoom ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
